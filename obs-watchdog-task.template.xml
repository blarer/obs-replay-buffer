<?xml version="1.0" encoding="UTF-16"?>
<!-- Template. setup.ps1 fills {{SID}}, {{USER}}, {{GATE}}, {{START}} and
     registers the result as "OBS Replay Buffer Watchdog". Do not edit the
     registered task by hand; re-run setup.ps1 instead. -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\OBS Replay Buffer Watchdog</URI>
    <Description>Keeps OBS and its replay buffer running. Runs obs-watchdog-gate.vbs every minute; see the obs-replay-buffer repo.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{{SID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Hidden>true</Hidden>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <Delay>PT30S</Delay>
      <UserId>{{USER}}</UserId>
    </LogonTrigger>
    <TimeTrigger>
      <StartBoundary>{{START}}</StartBoundary>
      <Repetition>
        <Interval>PT1M</Interval>
        <Duration>P3650D</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>"{{GATE}}"</Arguments>
    </Exec>
  </Actions>
</Task>
